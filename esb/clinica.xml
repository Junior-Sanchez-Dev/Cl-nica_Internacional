<resource uri-template="/comprobantes" methods="GET POST"><inSequence><property name="clinica.operacion" value="comprobantes"/><sequence key="ClinicaEntrada"/></inSequence><outSequence><sequence key="ClinicaSalida"/></outSequence><faultSequence><sequence key="ClinicaFallo"/></faultSequence></resource>
</api></definitions>